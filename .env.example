# Replace placeholders before starting. This file contains no usable secrets.
NOTIFICATION_PLUGIN_TOKEN=REPLACE_WITH_OPERATOR_GENERATED_RANDOM_TOKEN
# Leave empty for the preinstalled, not-yet-configured service. In this mode
# manifest and health remain available, validation fails with
# configuration_required, and send is explicitly rejected without network I/O.
# An operator may add exact approved host:port values before enabling email.
NOTIFICATION_SMTP_ALLOWED_SERVERS=
NOTIFICATION_SMTP_ALLOWED_CIDRS=
NOTIFICATION_PLUGIN_UI_ORIGINS=
NOTIFICATION_PLUGIN_LISTEN=0.0.0.0:5005
